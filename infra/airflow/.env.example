# Copie para .env ao lado do docker-compose.yaml (na VM) e preencha. O .env NÃO vai para o git.
# Valores com espaço ou parênteses vão entre aspas simples.

# ---------------------------------------------------------------- Airflow
# UID do seu usuário na VM (dono de logs/ e config/). Descubra com:  id -u
AIRFLOW_UID=1001

# Chave que criptografa as Connections e Variables do Airflow. Gere uma vez com:
#   openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=

# Chave dos tokens entre os componentes do Airflow 3. Gere com:  openssl rand -hex 32
JWT_SECRET=

# Senha do Postgres dos metadados do Airflow (só os containers usam). Gere com:  openssl rand -hex 16
POSTGRES_SENHA=

# ---------------------------------------------------------------- Oracle (Autonomous Database)
# Console da OCI > Autonomous Database > georural-dev > botão "Database connection" > TLS >
# linha georuraldev_tp > Copy. Exige a lista de acesso com o IP desta VM e o mTLS desligado.
GEORURAL_DB_DSN='(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-saopaulo-1.oraclecloud.com))(connect_data=(service_name=xxxx_georuraldev_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))'

# Usuário que o Airflow usa: o georural_airflow (só DML, criado pelo ADMIN) ou o da aplicação.
GEORURAL_DB_USUARIO=georural_airflow
GEORURAL_DB_SENHA=

# Dono das tabelas (o DB_USERNAME do back-end). Vazio se GEORURAL_DB_USUARIO já for o dono.
GEORURAL_DB_SCHEMA=GEO_RURAL

# ---------------------------------------------------------------- Object Storage
# Console da OCI > Storage > Buckets > o bucket do GeoRural: Namespace e Name.
# A autenticação é pela própria VM (dynamic group airflow-dg + policy): nada de chave aqui.
GEORURAL_OCI_NAMESPACE=
GEORURAL_OCI_BUCKET=
# Prefixo da zona bruta (o OCI_ZONA_BRUTA do back-end). Opcional: o padrão é "bruta".
# GEORURAL_OCI_ZONA_BRUTA=bruta

# ---------------------------------------------------------------- Processamento
# Registros lidos e gravados por vez. Menor = menos memória; maior = um pouco mais rápido.
GEORURAL_TAMANHO_LOTE=5000

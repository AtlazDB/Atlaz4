# Copie para .env ao lado do docker-compose.yaml. O .env NAO vai para o git.

# UID do dono dos arquivos montados (logs/, dags/). Na VM atual: 1001.
AIRFLOW_UID=1001

# Chave de criptografia das Connections e Variables do Airflow.
# Hoje esta VAZIA na VM, o que significa que senha guardada em Connection
# fica sem protecao. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

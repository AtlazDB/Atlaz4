# Copie para .env.local (mesma pasta) e preencha. O .env.local NÃO vai para o git.

# --- Oracle local (o mesmo que o back-end usa: Atlaz4-BackEnd/docker-compose.yaml)
# host.docker.internal = "o seu computador", visto de dentro do container
GEORURAL_DB_HOST=host.docker.internal
GEORURAL_DB_PORTA=1521
GEORURAL_DB_SERVICO=FREEPDB1
# Os mesmos DB_USERNAME e DB_PASSWORD do .env do back-end
GEORURAL_DB_USUARIO=
GEORURAL_DB_SENHA=
# Vazio no PC (você conecta com o dono das tabelas). Na VM: o schema da aplicação.
GEORURAL_DB_SCHEMA=

# --- Object Storage (o bucket real da OCI; os mesmos valores do .env do back-end)
GEORURAL_OCI_NAMESPACE=
GEORURAL_OCI_BUCKET=
# Pasta com o config e a chave .pem da OCI, com barras normais.
# Windows: C:/Users/SEU_USUARIO/.oci
OCI_CONFIG_DIR=

# --- Processamento
# Registros lidos e gravados por vez. Menor = menos memória; maior = um pouco mais rápido.
GEORURAL_TAMANHO_LOTE=5000

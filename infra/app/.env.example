# Copie para .env ao lado do docker-compose.yaml. O .env NAO vai para o git.

# Branch de cada repositorio que vai para o ar. Hoje o codigo so existe na dev
# (a main tem so o README). Troque para main quando o time comecar a mergear nela.
BACK_BRANCH=dev
FRONT_BRANCH=dev

# Porta publica do site. A 80/443 ja sao do Caddy do Airflow.
APP_PORT=8081

# Endereco que o grupo usa para abrir o site (entra na lista de CORS do back).
APP_CORS_ORIGENS=http://IP_PUBLICO_DA_VM:8081

# Banco. Senhas fortes, sem caractere especial que quebre JDBC (evite @ / : ").
# So valem na PRIMEIRA subida: depois disso o Oracle ja criou os usuarios no volume.
DB_ADMIN_PASSWORD=
DB_USERNAME=georural_app
DB_PASSWORD=

# Object Storage (zona bruta)
OCI_NAMESPACE=
OCI_BUCKET=
OCI_ZONA_BRUTA=bruta

# Pasta com config + chave da OCI na VM. Se ficar vazio, o deploy.sh usa $HOME/.oci.
OCI_CONFIG_DIR=
